{
    "name": "nightshade",
    "colors": {
      "bg": "#1A1120",
      "accent": "#F50087",
      "secondary": "#C580FF",
      "text": "#F0E8FF",
      "grid": "#2D1D3D"
    },
    "aliases": {
      "acc": "#F50087",
      "sec": "#C580FF",
      "txt": "#F0E8FF"
    },
    "palette": [
      "#F50087",
      "#C580FF",
      "#8A2BE2",
      "#FF69B4",
      "#FFFFFF",
      "#4B0082"
    ],
    "settings": {
